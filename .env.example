# --- STACK / PORTS ---
BACKEND_HOST_PORT=3001
FRONTEND_HOST_PORT=8080

# --- DATABASE ---
# SQLite file path used by Prisma.
# In Docker Compose `file:./data/app.db` resolves to `/app/backend/prisma/data/app.db`
# because the backend container mounts a persistent volume on `/app/backend/prisma/data`.
DATABASE_URL=file:./data/app.db

# --- BACKEND RUNTIME ---
BACKEND_NODE_ENV=production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3001
BACKEND_TRUST_PROXY=1
BACKEND_JSON_BODY_LIMIT=1mb

# --- BACKEND BOOTSTRAP ---
ADMIN_EMAIL=admin@example.com
# Generate a bcrypt hash without putting the plaintext password in shell history:
# npm --prefix backend run auth:hash-password
# Paste the printed value below wrapped in single quotes, for example:
# ADMIN_PASSWORD_HASH='$2b$12$.....................................................'
ADMIN_PASSWORD_HASH=''

# --- BACKEND SECURITY / COOKIES / CORS ---
# Replace in production with a random secret, for example:
# openssl rand -hex 32
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
COOKIE_NAME=token
COOKIE_DOMAIN=
COOKIE_PATH=/
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
COOKIE_MAX_AGE_MS=604800000
APP_ORIGIN=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# --- BACKEND MEDIA / LIMITS ---
UPLOAD_MAX_BYTES=10485760
SITE_TRANSFER_MAX_BYTES=536870912
MEDIA_STORAGE_ROOT=/app/media-storage
MEDIA_PUBLIC_BASE_PATH=/media
MEDIA_CACHE_MAX_AGE_SECONDS=3600
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX=5

# --- BACKEND SMTP / CONTACT ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
CONTACT_EMAIL_TO=info@example.com

# --- BACKEND NEWS / NEWSLETTER ---
NEWS_JOB_POLL_MS=5000
NEWS_JOB_LOCK_TIMEOUT_MS=60000
NEWS_EMAIL_BATCH_SIZE=25
NEWS_CONFIRM_TOKEN_TTL_HOURS=24

# --- BACKEND META SOCIAL (OPTIONAL) ---
META_ACCESS_TOKEN=
META_ACCESS_TOKEN_EXPIRES_AT=
META_FACEBOOK_PAGE_ID=
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- FRONTEND VITE ---
VITE_API_BASE_URL=
VITE_MEDIA_BASE_URL=
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=5173
# Keep aligned with BACKEND_HOST_PORT when changing the local API port.
VITE_DEV_PROXY_TARGET=http://localhost:3001
